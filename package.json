{
  "name": "prettyzap",
  "version": "0.2.4",
  "private": true,
  "description": "A secure desktop foundation around WhatsApp Web.",
  "author": "PrettyZap",
  "license": "MIT",
  "desktopName": "prettyzap",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && concurrently -k \"tsc -p tsconfig.main.json --watch\" \"electron .\"",
    "typecheck": "tsc -p tsconfig.main.json --noEmit",
    "build": "npm run typecheck && tsc -p tsconfig.main.json",
    "test": "npm run build && node --test dist/main/window-state.test.js dist/main/palette.test.js",
    "start": "electron .",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.prettyzap.desktop",
    "productName": "PrettyZap",
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "build/icons"
    },
    "asar": true,
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/features/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "dbus-next": "^0.10.2"
  }
}
